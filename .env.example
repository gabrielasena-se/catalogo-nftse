# Copie para .env.local (vercel env pull faz isso por você) e cadastre as mesmas
# variáveis na Vercel → Settings → Environment Variables.

# ===== Banco (Upstash Redis) =====
# Favoritos, itens extras do catálogo, vínculos Habbo <-> Discord e sessões.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Catálogo =====
# Senha do painel de admin (?admin=1).
ADMIN_SECRET=

# ===== BOT NFT-SE — Discord =====
# Developer Portal → General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Developer Portal → Bot → Token
DISCORD_TOKEN=
# Só para o npm run deploy-commands (não precisa na Vercel). Com ele, os comandos valem na
# hora neste servidor; sem ele, são globais.
DISCORD_GUILD_ID=
# Cargos concedidos ao verificar, separados por vírgula. Vazio: nenhum cargo.
VERIFY_ROLE_IDS=
# Opcional. Página que recebe o ?token= do link do Discord. Padrão: a raiz deste site.
CATALOG_URL=

# ===== Migração da Netlify (só para npm run migrar-netlify) =====
# Netlify → User settings → Applications → Personal access tokens
NETLIFY_AUTH_TOKEN=
# Opcional. Padrão: o site antigo do bot.
NETLIFY_SITE_ID=
