# ===== BOT NFT-SE — Discord =====
# Developer Portal → General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Developer Portal → Bot → Token
DISCORD_TOKEN=
# Servidor NFT. Com ele, os slash commands valem na hora; sem ele, são globais.
DISCORD_GUILD_ID=

# ===== Verificação =====
# Cargos concedidos ao verificar, separados por vírgula. Deixe vazio para não dar cargo nenhum.
VERIFY_ROLE_IDS=

# ===== Interno =====
# Segredo entre a função do Discord e a background function. Gerado automaticamente;
# troque com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=

# ===== Legado (pasta legacy/, desativada) =====
# Aniversários e bolão não rodam mais. Estas variáveis só voltam a importar se o código
# de legacy/ for religado num host com processo 24/7.
CHANNEL_BIRTHDAY_SETUP=
CHANNEL_REMINDER=
CHANNEL_GENERAL=
CHANNEL_BOLAO=
CRON_TIME=
TIMEZONE=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ===== Catálogo externo =====
# Página que recebe o token da sessão. Padrão: https://catalogo-nftse.vercel.app/
CATALOG_URL=
# Segredo que a aplicação externa manda em Authorization: Bearer <token>.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CATALOG_API_TOKEN=
